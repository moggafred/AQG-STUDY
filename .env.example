# AQG local environment example
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./aqg.db
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
MAX_UPLOAD_BYTES=10485760
GENERATION_REQUESTS_PER_MINUTE=5
RETRIEVAL_TOP_K=4
MIN_RETRIEVAL_SCORE=0.25
